# Copy to .env (gitignored) and fill in.
# Do not run two processes with the same Discord token.

DISCORD_TOKEN=
XAI_API_KEY=
PERSONA_ID=example
PERSONA_DIR=personas/example
DATA_DIR=data
WATCH_CHANNEL_ID=
MODEL_PROVIDER=xai
MODEL_PRIMARY=grok-4.6
MODEL_CHEAP=grok-4.3
COMPANION_TZ=America/Chicago

# Optional other providers — /model lists whatever keys are present
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Outreach
REACH_ENABLED=true
REACH_MAX_PER_DAY=2
REACH_MIN_SILENCE_HOURS=2
REACH_CHECK_MINUTES=30
REACH_QUIET_START=22
REACH_QUIET_END=5

# Experimental single-speaker Discord live transcription
# Audio is sent to Gladia; live mode does not save raw audio.
GLADIA_API_KEY=
VOICE_ENABLED=false
VOICE_ENDPOINTING_SECONDS=0.1
VOICE_QUEUE_SECONDS=2.0
# Allows Gladia Live V2 to drain final transcripts and close its session.
VOICE_GLADIA_STOP_SECONDS=15.0
# Reserved for the Phase 3 local speech-evidence gate.
VOICE_MIN_SPEECH_MS=120
