# Copy to .env (gitignored) and fill in.
# Do not run two processes with the same Discord token.

DISCORD_TOKEN=
XAI_API_KEY=
PERSONA_ID=example
PERSONA_DIR=personas/example
DATA_DIR=data
WATCH_CHANNEL_ID=
MODEL_PROVIDER=xai
MODEL_PRIMARY=grok-4.6
MODEL_CHEAP=grok-4.3
COMPANION_TZ=America/Chicago

# Optional other providers — /model lists whatever keys are present
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Outreach
REACH_ENABLED=true
REACH_MAX_PER_DAY=2
REACH_MIN_SILENCE_HOURS=2
REACH_CHECK_MINUTES=30
REACH_QUIET_START=22
REACH_QUIET_END=5
