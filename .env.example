# Copy to .env (gitignored) and fill in.
# Do not run two processes with the same Discord token.

DISCORD_TOKEN=
XAI_API_KEY=
PERSONA_ID=example
PERSONA_DIR=personas/example
DATA_DIR=data
WATCH_CHANNEL_ID=
# Stable Discord user ID allowed to share private continuity across surfaces.
# When set, other users receive no partner facts, recall, journal, or control commands.
PARTNER_USER_ID=
# Additional private/low-traffic channels where ordinary messages get a reply.
# WATCH_CHANNEL_ID remains supported and remains the outreach destination.
ACTIVE_CHANNEL_IDS=
# Shared rooms: social may join through local attention; addressed needs a summons;
# ignored never responds. A channel ID may appear in only one mode.
SOCIAL_CHANNEL_IDS=
# Discord user IDs for explicitly approved AI residents in social rooms.
# Naomi ignores herself and all other bot accounts.
SOCIAL_RESIDENT_USER_IDS=
ADDRESSED_CHANNEL_IDS=
IGNORED_CHANNEL_IDS=
# Bounded recent context from other rooms in the configured partner continuity.
CROSS_SURFACE_RECENT_MESSAGES=12
CROSS_SURFACE_RECENT_CHARS=4000
CROSS_SURFACE_RECENT_MINUTES=120
MODEL_PROVIDER=xai
MODEL_PRIMARY=grok-4.6
MODEL_CHEAP=grok-4.3
# Canonical public-room response model. Defaults to MODEL_PRIMARY when empty.
MODEL_SOCIAL=
COMPANION_TZ=America/Chicago
# MOMENTS_THRESHOLD=0.7
# JOURNAL_THRESHOLD still works as the same setting (old name).

# Optional local ambient attention for SOCIAL_CHANNEL_IDS. Disabled by default.
# Requires a public persona document under docs/public/ and a local Ollama model.
SOCIAL_AMBIENT_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
SOCIAL_ATTENTION_MODEL=qwen3:1.7b
SOCIAL_ATTENTION_TIMEOUT_SECONDS=15
SOCIAL_ATTENTION_THREADS=4
SOCIAL_ATTENTION_CONTEXT_TOKENS=2048
SOCIAL_DEBOUNCE_SECONDS=3
SOCIAL_BUFFER_MESSAGES=12
SOCIAL_BUFFER_CHARS=4000
SOCIAL_ENGAGEMENT_SECONDS=120
SOCIAL_COOLDOWN_SECONDS=30
SOCIAL_BUDGET_CAPACITY=6
SOCIAL_BUDGET_REFILL_PER_HOUR=2
SOCIAL_HISTORY_MESSAGES=24
SOCIAL_RESPONSE_MAX_TOKENS=600
SOCIAL_DIRECT_BURST=3
SOCIAL_DIRECT_REFILL_PER_MINUTE=2
# Stops unattended resident-to-resident reply loops; human speech resets it.
SOCIAL_AI_CHAIN_LIMIT=4

# Optional other providers — /model lists whatever keys are present
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Outreach
REACH_ENABLED=true
REACH_MAX_PER_DAY=2
REACH_MIN_SILENCE_HOURS=2
REACH_CHECK_MINUTES=30
REACH_QUIET_START=22
REACH_QUIET_END=5

# Experimental single-speaker Discord live transcription
# Audio is sent to Gladia; live mode does not save raw audio.
GLADIA_API_KEY=
VOICE_ENABLED=false
VOICE_ENDPOINTING_SECONDS=0.1
VOICE_QUEUE_SECONDS=2.0
# Allows Gladia Live V2 to drain final transcripts and close its session.
VOICE_GLADIA_STOP_SECONDS=15.0
# Bounded same-session recovery for an unexpectedly closed Gladia WebSocket.
# An ambiguously delivered PCM frame is dropped, never replayed.
VOICE_GLADIA_RECONNECT_ATTEMPTS=3
VOICE_GLADIA_RECONNECT_INITIAL_DELAY_SECONDS=0.5
VOICE_GLADIA_RECONNECT_MAX_DELAY_SECONDS=5.0
VOICE_GLADIA_RECONNECT_CONNECT_TIMEOUT_SECONDS=10.0
# Start a fresh Gladia session at 2h50m, before the three-hour hard limit.
VOICE_GLADIA_ROTATE_SECONDS=10200
# Minimum locally corroborated speech inside a Gladia final.
VOICE_MIN_SPEECH_MS=120
# Quiet debounce used to combine nearby stable finals into one natural turn.
VOICE_TURN_DEBOUNCE_SECONDS=1.5

# Optional Phase 4 outbound speech. The same Discord text reply is spoken.
VOICE_TTS_ENABLED=false
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_flash_v2_5
ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
ELEVENLABS_STYLE=0.0
ELEVENLABS_SPEAKER_BOOST=false
ELEVENLABS_SPEED=1.0
VOICE_PLAYBACK_QUEUE_SECONDS=2.0
# Phase 5B intentional barge-in. Requires the companion's name plus a cue such
# as "Naomi, wait"; ordinary overlapping speech continues to queue.
VOICE_BARGE_IN_ENABLED=false
VOICE_BARGE_IN_MIN_SPEECH_MS=160
